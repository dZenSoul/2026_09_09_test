# Required. Replace the examples in a local .env; do not use them in production.
POSTGRES_DSN=postgres://documents:local-password@localhost:5432/documents?sslmode=disable
ADMIN_TOKEN=replace-with-a-long-random-value

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

STORAGE_DRIVER=filesystem
FILE_STORAGE_ROOT=./data/blobs
# S3_ENDPOINT=s3.example.test
# S3_REGION=us-east-1
# S3_BUCKET=documents
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# S3_USE_TLS=true

SESSION_TTL=24h
CACHE_TTL=5m
CACHE_MAX_BYTES=67108864
CACHE_MAX_ITEMS=1000
MAX_REQUEST_BYTES=33554432
MAX_FILE_BYTES=26214400
MAX_JSON_BYTES=1048576
MAX_GRANT_ITEMS=100
MAX_LIST_LIMIT=100
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_PROCESSING_TIMEOUT=30s
GRACEFUL_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
EXPOSE_CACHE_HEADER=false
