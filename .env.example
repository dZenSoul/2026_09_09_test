# Required. Replace the examples in a local .env; do not use them in production.
POSTGRES_USER=documents
POSTGRES_PASSWORD=local-password
POSTGRES_DB=documents
POSTGRES_DSN=postgres://documents:local-password@db:5432/documents?sslmode=disable
ADMIN_TOKEN=local-admin-token-change-me
IMAGE_TAG=dev
APP_PORT=8080
# Used only with compose.local.yaml.
POSTGRES_HOST_PORT=5432

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

STORAGE_DRIVER=filesystem
FILE_STORAGE_ROOT=/data/blobs
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_TLS=true

SESSION_TTL=24h
CACHE_TTL=5m
CACHE_MAX_BYTES=67108864
CACHE_MAX_ITEMS=1000
MAX_REQUEST_BYTES=33554432
MAX_FILE_BYTES=26214400
MAX_JSON_BYTES=1048576
MAX_GRANT_ITEMS=100
MAX_LIST_LIMIT=100
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_PROCESSING_TIMEOUT=30s
GRACEFUL_SHUTDOWN_TIMEOUT=10s
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
POSTGRES_HEALTH_CHECK_PERIOD=1m
LOG_LEVEL=info
EXPOSE_CACHE_HEADER=false
